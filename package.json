{
  "name": "LiveFolio-oss-core",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev -p 3001",
    "build": "cross-env NEXT_PUBLIC_APP_ENV=oss next build",
    "analyze": "cross-env ANALYZE=true NEXT_PUBLIC_APP_ENV=oss next build",
    "start": "cross-env NODE_ENV=production node server.ts",
    "lint": "eslint app components lib hooks ee bin --ext .ts,.tsx || true",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "vitest": {
    "include": [
      "tests/**/*.test.ts"
    ],
    "alias": {
      "@": "."
    }
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@google/genai": "latest",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.65.0",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "fuse.js": "^7.4.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "0.460.0",
    "motion": "^12.42.0",
    "next": "^16.3.4",
    "next-mdx-remote": "^6.0.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "untun": "^0.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.14.9",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "fast-uri": "^3.1.7",
    "js-yaml": "^4.3.2",
    "sharp": "^0.35.4",
    "gray-matter": {
      "js-yaml": "^3.15.2"
    }
  }
}
